    {
      "id": "cuarentena-rap",
      "name": "Cuarentena Rap",
      "subtitle": "Liga Multiplataforma en Confinamiento & Dispositivo Socio-Artístico",
      "years": "2020 - 2021",
      "concept": {
        "title": "La Muerte Simbólica y el Viaje hacia la Liberación",
        "summary": "Durante los confinamientos por COVID-19, Cuarentena Rap transformó el trauma del aislamiento en un certamen poético-competitivo conceptual. Los emcees ingresaban simbólicamente muertos (confinados e inactivos), enfrentaban sus crisis en la Fase de Karmas y alcanzaban la catarsis y liberación a través del arte colectivo.",
        "phases": [
          {
            "phase": "01. Filtros Clasificatorios",
            "desc": "Audiciones masivas a ciegas con cientos de postulantes evaluados por letristas consagrados de la escena latinoamericana."
          },
          {
            "phase": "02. Fase de Tumbas",
            "desc": "Ruptura del silencio. Los emcees despiertan del letargo pandémico y reactivan su lírica en el cuadrilátero virtual."
          },
          {
            "phase": "03. Fase de Karmas",
            "desc": "El núcleo narrativo: purga poética de duelos, conflictos personales, encierro y angustia estructural, sustituyendo la rima vacía por contenido sustantivo."
          },
          {
            "phase": "04. Semifinales y Liberación (Gran Final)",
            "desc": "Clímax competitivo con duelos escritos de alto nivel técnico ante miles de espectadores simultáneos en YouTube y Twitch, coronando a Crizzo."
          }
        ]
      },
      "pillars": [
        {
          "name": "MCing / Freestyle & Batallas Escritas",
          "details": "Rúbricas de evaluación transparentes ponderando criterio lírico, flow, métricas y coherencia conceptual."
        },
        {
          "name": "Breaking",
          "details": "Torneo virtual de B-Boys y B-Girls evaluados en video de alto framerate para vencer el confinamiento físico."
        },
        {
          "name": "Beatmaking",
          "details": "Showcase y batalla de beatmakers produciendo instrumentales boom-bap y texturas exclusivas para cada etapa."
        },
        {
          "name": "Beatboxing",
          "details": "Torneo de percusión vocal transformando el micrófono en sintetizadores y baterías en vivo."
        }
      ],
      "network": "Federación de ligas y plazas de Chile, Argentina, Colombia, Perú y México con cuerpo de jueces internacionales.",
